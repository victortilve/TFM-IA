@prefix ex: <http://example.org#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix sf: <http://www.opengis.net/ont/sf#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix wgs84: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

# Clase para redes de sensores
ex:PhotometerNetwork a rdfs:Class ;
    rdfs:label "Red de fotómetros"@es ;
    rdfs:subClassOf sosa:Platform ;
    rdfs:comment "Grupo organizado de fotómetros con un objetivo común."@es .

# Instancia para la red de FreeDSM
ex:FreeDSM_Network_Gaia4sustainability a ex:PhotometerNetwork ;
    dcterms:isPartOf ex:Gaia4sustainability ; #definida en organizacionesFabricantes.ttl
    rdfs:label "Red FreeDSM de Gaia4sustainability"@es ;
    rdfs:comment "Red de fotómetros FreeDSM del proyecto Gaia4sustainability mantinda por el CITIC de la Univ. da Coruña."@es ;
    foaf:homepage <https://dsm.citic.udc.es/devices> .
    
ex:FreeDSM_UNEDPontevedra_PON_42.442671_-8.6277722 a ex:FreeDSM;
    rdfs:label "FreeDSM UNED-Pontevedra"@es ;
    dcterms:isPartOf ex:FreeDSM_Network_Gaia4sustainability ;
    rdfs:comment "Sensor de brillo del cielo instalado en el centro asociado de la UNED en Pontevedra (Monteporreiro), parte de la red Gaia4sustainability."@es ;
    geo:hasGeometry [
        a sf:Point ;
        geo:asWKT "POINT(-8.6277722 42.442671)"^^geo:wktLiteral ;
        wgs84:alt "63"^^xsd:decimal
    ] .

ex:FreeDSM_Pereiro_VIG_42.205304_-8.7435079 a ex:FreeDSM ;
    rdfs:label "FreeDSM en Pereiró, Vigo."@es ;
    dcterms:isPartOf ex:FreeDSM_Network_Gaia4sustainability ;
    rdfs:comment "Sensor de brillo del cielo instalado en Pereiró, Vigo, parte de la red Gaia4sustainability."@es ;
    geo:hasGeometry [
        a sf:Point ;
        geo:asWKT "POINT(-8.3733263 42.6106673)"^^geo:wktLiteral ;
        wgs84:alt "32"^^xsd:decimal
    ] .

