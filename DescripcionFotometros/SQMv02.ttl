@prefix dc: <http://purl.org/dc/terms/> .
@prefix ex: <http://example.org#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix qudt-unit: <https://qudt.org/vocab/unit/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix om: <http://www.ontology-of-units-of-measure.org/resource/om-2/> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .

ex:SQM a sosa:Sensor;
	sosa:observes ex:NightSkyBrightness;
	dc:hasPart ex:TSL237;
    dc:hasPart ex:HOYA_CM-500_filter;
    rdfs:label "Fotómetro Sky Quality Meter (SQM)."@es ;
    dc:creator ex:Unihedron ;
    rdfs:seeAlso <https://www.unihedron.com/projects/darksky/>;
    rdfs:comment "Clase de fotómetros para medir el brillo del cielo nocturno. Se define a partir del SQM-L y se abusa del lenguaje"@es ;
    ex:hasSpectralBand ex:SQM_SpectralBand ;
    ex:hasDefaultUnit om:magnitudePerSecond-AngleSquared ;
    ex:hasFWHM ex:SQM_FWHM;
    ex:hasFieldOfView ex:SQM_FoV .

ex:TSL237 a sosa:Sensor;
    dc:isPartOf ex:SQM ;
	rdfs:seeAlso <https://ams-osram.com/products/photodetectors/photodiodes/ams-tsl237-light-to-frequency> ;
	rdfs:comment "Convertidor de luz a frecuencia."@es .
    
ex:HOYA_CM-500_filter a sosa:Sensor;
    dc:isPartOf ex:SQM ;
    rdfs:seeAlso <https://www.uqgoptics.com/materials/hoya-cm-500/>;
	rdfs:comment "Filtro de color Hoya CM-500."@es .

ex:SQM_LE a sosa:Sensor ;
    rdfs:label "SQM-LE"@es ;
    rdfs:comment "Modelo de SQM con conectividad Ethernet."@es ;
    dc:isVersionOf ex:SQM .

ex:SQM_LR a sosa:Sensor ;
    rdfs:label "SQM-LR"@es ;
    rdfs:comment "Modelo de SQM con conectividad RS232."@es ;
    dc:isVersionOf ex:SQM .

ex:SQM_LU a sosa:Sensor ;
    rdfs:label "SQM-LU"@es ;
    rdfs:comment "Modelo de SQM con conectividad USB."@es ;
    dc:isVersionOf ex:SQM .

ex:SQM_LU_DL a sosa:Sensor ;
    rdfs:label "SQM-LU-DL"@es ;
    rdfs:comment "Modelo de SQM con conectividad USB y almacenamiento interno de datos."@es ;
    dc:isVersionOf ex:SQM .

# Definición de la banda espectral
ex:SQM_SpectralBand a om:SpectralResponse ;
    rdfs:label "Banda espectral del SQM"@es ;
    rdfs:comment "El SQM mide en el espectro visible entre 400 nm y 700 nm."@es ;
    qudt:lowerBound [
        a qudt:QuantityValue ;
        qudt:numericValue "400.0"^^xsd:float ;
        qudt:unit qudt-unit:NanoM
    ] ;
    qudt:upperBound [
        a qudt:QuantityValue ;
        qudt:numericValue "700.0"^^xsd:float ;
        qudt:unit qudt-unit:NanoM
    ] .

# Apertura
ex:SQM_FoV a om:SolidAngle ;
    rdfs:label "Campo de visión estándar del sensor SQM"@es ;
    rdfs:seeAlso <https://www.unihedron.com/projects/darksky/faqsqm.php>;
    om:hasValue [
        a qudt:QuantityValue ;
        qudt:numericValue "1.532"^^xsd:float ;
        qudt:unit om:steradian 
    ].

ex:SQM_FWHM a om:Angle;
    rdfs:comment "FWHM (Full Width at Half Maximum) del campo de visión angular del sensor SQM. Representa el ángulo con sensibilidad superior al 50% del máximo."@es ;
    rdfs:seeAlso <https://unihedron.com/projects/sqm-l/fovannotated.jpg> ;
    rdfs:seeAlso wd:Q1065170 ; #FWHM en WikiData
    om:hasValue [
        a qudt:QuantityValue ;
        qudt:numericValue "20"^^xsd:float ;
        qudt:unit om:degree 
    ].
