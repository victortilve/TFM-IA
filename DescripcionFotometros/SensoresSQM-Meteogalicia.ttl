@prefix ex: <http://example.org#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix sf: <http://www.opengis.net/ont/sf#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix wgs84: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix wd: <https://www.wikidata.org/wiki/>.
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

# Clase para redes de sensores
ex:PhotometerNetwork a rdfs:Class ;
    rdfs:label "Red de fotómetros"@es ;
    rdfs:subClassOf sosa:Platform ;
    rdfs:comment "Grupo organizado de fotómetros con un objetivo común."@es .

# Instancia para la red de SQMs
ex:SQM_Network_MeteoGalicia a ex:PhotometerNetwork ;
    dcterms:isPartOf ex:MeteoGalicia ;
    rdfs:label "Red SQMs MeteoGalicia"@es ;
    rdfs:comment "Red de fotómetros SQM de la agencia meteorológica de Galicia, Meteogalicia."@es ;
    foaf:homepage <https://www.meteogalicia.gal/web/ica/brillo-do-ceo> .
    
ex:SQM_Campolongo_PON_42.425896_-8.643984 a ex:SQM_LR ;
    rdfs:label "SQM Campolongo (PON)" ;
    dcterms:isPartOf ex:SQM_Network_MeteoGalicia ;
    rdfs:comment "Sensor de brillo del cielo instalado en Campolongo (Pontevedra), parte de la red MeteoGalicia." ;
    geo:hasGeometry [
        a sf:Point ;
        geo:asWKT "POINT(-8.643984 42.425896)"^^geo:wktLiteral ;
        wgs84:alt "20"^^xsd:decimal
    ] .

