PREFIX geo:  <http://www.opengis.net/ont/geosparql#>
PREFIX geof: <http://www.opengis.net/def/function/geosparql/>

SELECT ?sensor ?ptWKT
WHERE {
  # Puntos (sensores)
  ?sensor geo:hasGeometry/geo:asWKT ?ptWKT .
  # Normaliza CRS84 para el punto si no lo trae
  BIND(
    IF(STRSTARTS(STR(?ptWKT), "<"),
       STRDT(STR(?ptWKT), geo:wktLiteral),
       STRDT(CONCAT("<http://www.opengis.net/def/crs/OGC/1.3/CRS84> ", STR(?ptWKT)), geo:wktLiteral)
    ) AS ?pt84
  )

  FILTER NOT EXISTS {
    # Polígonos (zonas)
    ?zona geo:hasGeometry/geo:asWKT ?polyWKT .
    BIND(
      IF(STRSTARTS(STR(?polyWKT), "<"),
         STRDT(STR(?polyWKT), geo:wktLiteral),
         STRDT(CONCAT("<http://www.opengis.net/def/crs/OGC/1.3/CRS84> ", STR(?polyWKT)), geo:wktLiteral)
      ) AS ?poly84
    )
    FILTER( geof:sfWithin(?pt84, ?poly84) )
  }
}
ORDER BY ?sensor
